{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "src",
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true,
    "declaration": false,
    "sourceMap": false,
    "strict": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/cli/flow.ts"]
}

diagram 1
type overview

overview resume-app "Resume app"
purpose "Prepare a relevant resume using truthful career evidence."
group role-and-evidence "Role & evidence" {
  capability understand-job-requirements "Understand job requirements" detail="Make the role legible before deciding which experience matters."
  capability inventory-career-evidence "Inventory career evidence" detail="Gather truthful, specific evidence from the person's existing career material."
  capability see-matches-and-gaps "See matches and gaps" detail="Show where the evidence supports the role and where it needs attention."
}
group drafting "Drafting" {
  capability tailor-resume-to-role "Tailor a resume to a role" detail="Draft focused changes using the selected requirements and career evidence."
    flow "src/data/flows/resume-alignment.diagram"
  capability prioritize-useful-changes "Prioritize useful changes" detail="Spend effort where a change can improve the result without adding noise."
}
group review-and-output "Review & output" {
  capability review-suggested-edits "Review suggested edits" detail="Inspect each proposed change and keep the reasoning visible for a human review."
  capability approve-final-resume "Approve a final resume" detail="Confirm that the final document is accurate, useful, and ready to share."
  capability export-result "Export the result" detail="Produce the finished resume in a form that can leave the workbench."
}

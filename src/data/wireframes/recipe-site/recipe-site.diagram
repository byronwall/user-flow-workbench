screen shopping "Shopping list" basis=observed reference=shopping-site {
  frame page content=1320 {
    body {
      bar navigation {
        start {
          link recipes-link "recipes" goto=recipes
          link plan-link "plan" goto=plan
          badge "list"
          link purchases-link "purchases"
          link ingredients-link "ingredients"
          link ai-link "ai" goto=ai
          link kroger-link "kroger"
        }
        end {
          button sign-out "sign out"
        }
      }
      text "Shopping list" role=title
      list included-recipes mode=plain {
        item potato "baked potato bar" action=remove
        item guacamole "Guacamole" action=remove
        item cowboy "Cowboy Caviar" action=remove
        item sabzi "Sabzi Pullao- Vegetables with Fried Rice" action=remove
        item coconut "Coconut Shrimp Cream Curry" action=remove
        item beef "Slow Cooker Beef and Broccoli" action=remove
      }
      bar shopping-actions {
        start {
          button add-loose "＋ Add loose item" icon=add
          button delete-all "Delete all" icon=trash tone=destructive
          button delete-bought "Delete bought" icon=trash
          button copy-notes "Copy for Notes" icon=copy
        }
        end {
          button group-recipe "Recipe"  state=selected
          button group-aisle "Aisle"
        }
      }
      panel coconut-items-panel {
        text "Coconut Shrimp Cream Curry" role=heading
        list coconut-items mode=checkable {
          item tomato "2 tbsp tomato paste" state=checked action=remove
          item cayenne "1 tsp cayenne pepper" state=checked action=remove
          item bay "2 bay leaves" state=checked action=remove
          item jalapeno "1 jalapeno thinly sliced" state=checked action=remove
          item coconut-milk "2 cans coconut milk" state=unchecked action=remove
        }
        checkbox show-pantry "Show pantry items" state=unchecked
      }
    }
  }
}

screen ai "AI recipe generator" basis=observed reference=ai-site {
  frame page content=1240 {
    body {
      bar navigation {
        start {
          link recipes-link "recipes" goto=recipes
          link plan-link "plan" goto=plan
          link list-link "list" goto=shopping
          link purchases-link "purchases"
          link ingredients-link "ingredients"
          badge "ai"
          link kroger-link "kroger"
        }
        end {
          button sign-out "sign out"
        }
      }
      text "AI Recipe Generator" role=title
      textarea prompt "Prompt" value="Large group meal for someone with celiac disease and peanut allergies. Include a main dish and side. Keep it kid friendly."
      grid generator-options columns=3 {
        select servings "Servings (optional)" value="Optional"
        select time-limit "Time limit minutes (optional)" value="Optional"
        select count "How many?" value="3"
      }
      button generate "Generate" icon=sparkles
      bar generated-actions {
        start {
          text "Generated 3 recipes" role=caption
        }
        end {
          button select-all "□ Select all"
          button save-selected "Save selected (0)"  state=disabled
        }
      }
      list generated-recipes mode=plain {
        item chicken-bake "Gluten-Free Chicken and Vegetable Bake" detail="45 min · kid-friendly · gluten-free · one-pan meal"
        item beef-bowls "Peanut-Free Beef and Rice Bowls" detail="35 min · family-style · dairy-free"
        item taco-bar "Build-Your-Own Chicken Taco Bar" detail="40 min · gluten-free · serves a crowd"
      }
    }
  }
}

screen recipe-details "Recipe details" basis=observed reference=recipe-details-site {
  frame page content=1320 {
    body {
      bar navigation {
        start {
          link recipes-link "recipes" goto=recipes
          link plan-link "plan" goto=plan
          link list-link "list" goto=shopping
          link purchases-link "purchases"
          link ingredients-link "ingredients"
          link ai-link "ai" goto=ai
          link kroger-link "kroger"
        }
        end {
          button sign-out "sign out"
        }
      }
      panel recipe-header {
        text "Apple Pie" role=title
        text "DESSERT · + Tag" role=caption
        text "A classic apple pie with a crisp crust and warm cinnamon filling." role=body
      }
      panel recipe-actions {
        text "ACTIONS" role=heading
        grid action-buttons columns=2 {
          button plan-recipe "Plan" icon=calendar-add
          button list-recipe "List" icon=cart
          button touch-up "Touch up" icon=sparkles
          button cook-recipe "Cook it" icon=chef-hat
        }
        button delete-recipe "Delete" icon=trash tone=destructive
      }
      grid recipe-content columns=2 {
        panel ingredients-panel {
          text "ingredients" role=heading
          list ingredients-list mode=plain {
            item cinnamon "1 1/2 tsp cinnamon"
            item butter "8 Tbsp unsalted butter"
            item flour "3 Tbsp all-purpose flour"
            item water "1/4 cup water"
            item sugar "1 cup granulated sugar"
            item egg "1 egg, plus 1 Tbsp water, for egg wash"
            item apples "2 1/4 lbs Granny Smith apples, peeled and cored"
            item ice-cream "1 vanilla ice cream"
            item crust "1 double pie crust"
          }
        }
        panel instructions-panel {
          text "instructions" role=heading
          list instructions-list mode=ordered {
            item step-one "Make the pie crust and chill it. Preheat the oven to 425°F."
            item step-two "Melt butter over medium heat. Whisk in flour, water, and sugar. Simmer for 3 minutes."
            item step-three "Peel, core, and slice the apples. Add cinnamon and coat with the sauce."
            item step-four "Roll out the crust, fill the pie, and seal the top crust."
            item step-five "Bake until the crust is golden and the filling bubbles."
          }
        }
      }
    }
  }
}

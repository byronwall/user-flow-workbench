diagram 1
type wireframe

wireframe recipe-site "Recipe planning website"
viewport 1440 900
theme recipe

reference recipes-site image="src/data/wireframes/recipe-site/references/recipes.png" width=1864 height=1424 state="Recipe library"
reference plan-site image="src/data/wireframes/recipe-site/references/plan.png" width=1978 height=1230 state="Planned meals"
reference shopping-site image="src/data/wireframes/recipe-site/references/shopping-list.png" width=1480 height=1498 state="Shopping list"
reference ai-site image="src/data/wireframes/recipe-site/references/ai.png" width=1802 height=1510 state="AI recipe generator"
reference recipe-details-site image="src/data/wireframes/recipe-site/references/recipe-details.png" width=1826 height=1504 state="Apple Pie recipe details"

screen recipes "Recipe library" basis=observed reference=recipes-site {
  shot rest
  shot create-open open=new-recipe-popover

  frame page content=1320 {
    body {
      bar navigation {
        start {
          badge "recipes"
          link plan-link "plan" goto=plan
          link list-link "list" goto=shopping
          link purchases-link "purchases"
          link ingredients-link "ingredients"
          link ai-link "ai" goto=ai
          link kroger-link "kroger"
        }
        end {
          button sign-out "sign out"
        }
      }
      grid filters columns=2 {
        panel search-filters {
          text "SEARCH" role=heading
          field recipe-search "Search" value="Search recipes"
          select tag-filter "TAGS" value="More tags"
        }
        panel type-filters {
          text "TYPE" role=heading
          grid meal-types columns=3 {
            button all "All"  state=selected
            button breakfast "BREAKFAST"
            button lunch "LUNCH"
            button dinner "DINNER"
            button dessert "DESSERT"
            button snack "SNACK"
            button drink "DRINK"
            button appetizer "APPETIZER"
            button side "SIDE"
          }
        }
      }
      bar recipe-actions {
        end {
          button new-recipe "＋ New Recipe" icon=add
        }
      }
      popover new-recipe-popover trigger=new-recipe {
        text "New Recipe" role=heading
        field recipe-name "Name" value="Recipe name"
        select recipe-type "Type" value="Dinner"
        field recipe-tags "Tags" value="Add tags"
        button save-recipe "Save recipe"
      }
      grid recipe-grid columns=3 {
        panel apple-pie-card {
          card apple-pie "Apple Pie" detail="DESSERT · + Tag" goto=recipe-details
          bar apple-pie-actions {
            end {
              button apple-plan "Add to plan" icon=calendar-add
              button apple-list "Add to list" icon=cart
            }
          }
        }
        panel salmon-card {
          card salmon "Asian Salmon in Foil" detail="DINNER · + Tag"
          bar salmon-actions {
            end {
              button salmon-plan "Add to plan" icon=calendar-add
              button salmon-list "Add to list" icon=cart
            }
          }
        }
        panel casserole-card {
          card casserole "Bacon Breakfast Casserole" detail="BREAKFAST · + Tag"
          bar casserole-actions {
            end {
              button casserole-plan "Add to plan" icon=calendar-add
              button casserole-list "Add to list" icon=cart
            }
          }
        }
        panel feta-pasta-card {
          card feta-pasta "Baked Feta Pasta" detail="DINNER · + Tag"
          bar feta-pasta-actions {
            end {
              button feta-plan "Add to plan" icon=calendar-add
              button feta-list "Add to list" icon=cart
            }
          }
        }
        panel potato-bar-card {
          card potato-bar "baked potato bar" detail="DINNER · + Tag"
          bar potato-bar-actions {
            end {
              button potato-plan "Add to plan" icon=calendar-add
              button potato-list "Add to list" icon=cart
            }
          }
        }
        panel baked-spaghetti-card {
          card baked-spaghetti "Baked Spaghetti" detail="DINNER · + Tag · allrecipes.com"
          bar baked-spaghetti-actions {
            end {
              button spaghetti-plan "Add to plan" icon=calendar-add
              button spaghetti-list "Add to list" icon=cart
            }
          }
        }
      }
    }
  }
}

screen plan "Planned meals" basis=observed reference=plan-site {
  frame page content=1320 {
    body {
      bar navigation {
        start {
          link recipes-link "recipes" goto=recipes
          badge "plan"
          link list-link "list" goto=shopping
          link purchases-link "purchases"
          link ingredients-link "ingredients"
          link ai-link "ai" goto=ai
          link kroger-link "kroger"
        }
        end {
          button sign-out "sign out"
        }
      }
      text "Planned Meals" role=title
      bar calendar-controls {
        start {
          toggle hide-made "Hide made meals" state=on
        }
        end {
          button previous "‹" icon=chevron-left
          button today "Today"
          button next "›" icon=chevron-right
        }
      }
      grid calendar columns=7 min=120 {
        panel day-23 {
          text "SUN" role=caption
          text "23 AUG" role=heading
          button add-23 "＋" icon=add
        }
        panel day-24 {
          text "MON" role=caption
          text "24 AUG" role=heading
          button add-24 "＋" icon=add
        }

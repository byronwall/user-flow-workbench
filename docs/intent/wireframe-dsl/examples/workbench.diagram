diagram 1
type wireframe

wireframe resume-workbench "Resume workbench: current and proposed screens"
viewport 1280 720
reference current image="docs/intent/wireframe-dsl/reference/current-ui.jpg" width=1280 height=720 captured="2026-08-30" state="Historical base resume flow; node list open in the right inspector"
part flow-header {
  bar {
    start {
      text "User Flow Workbench" role=heading
    }
    end {
      button layout "Auto layout"
      button fit "Fit"
      button files "All diagrams" goto=picker
      button export "Export JSON"
    }
  }
}
part overview-header {
  bar {
    start {
      text "User Flow Workbench" role=heading
      badge "Overview"
    }
    end {
      button reload "Reload source"
      button files "All diagrams" goto=picker
    }
  }
}
part inspector-tabs {
  tabs sections {
    tab inspect "Inspector" state=active
    tab source "Diagram DSL"
  }
}
part flow-inspector {
  tabs sections {
    tab inspect "Inspector" state=active
    tab source "Diagram DSL"
  }
  text "Nodes" role=heading
  text "Select a node to inspect its details."
  notice scope "Simplified inspector" detail="This sketch omits the full node list."
}
screen current "Current structure: simplified reference" basis=source reference=current {
  frame workbench {
    header {
      use header-controls flow-header
    }
    top {
      tabs views {
        tab base "Base" state=active
      }
    }
    main {
      diagram workflow source="src/data/flows/resume-alignment.diagram" view=base
    }
    aside {
      use inspector-content flow-inspector
    }
  }
}
screen overview "Capability overview" basis=proposed reference=current {
  mark main "Show the canonical capability overview."
  mark header-controls "Use source actions instead of graph editing."
  frame workbench {
    header {
      use header-controls overview-header
    }
    main {
      diagram board source="src/data/overviews/resume-app.diagram" view=base
    }
    aside {
      use inspector-controls inspector-tabs
      text "About this overview" role=heading
      text "Resume app" role=title
      text "A working idea, ready to reduce through conversation."
      link open-capability "Inspect resume tailoring" goto=capability
      text "Source current. Edit through your agent." role=caption
    }
  }
}
screen capability "Selected capability" basis=proposed reference=current {
  mark aside "Show capability detail and its related flow."
  frame workbench {
    header {
      use header-controls overview-header
    }
    main {
      diagram board source="src/data/overviews/resume-app.diagram" view=base focus=tailor-resume-to-role
    }
    aside {
      use inspector-controls inspector-tabs
      text "Capability" role=caption
      text "Tailor a resume to a role" role=title
      text "Drafting" role=caption
      text "Draft focused changes from career evidence and the selected job requirements."
      rule
      text "Related flows" role=heading
      button open-flow "Tailor a resume to a job posting" goto=linked-flow
      text "This inspector copy is a sketch, not a live binding." role=caption
    }
  }
}
screen linked-flow "Flow opened from a capability" basis=proposed reference=current {
  mark return-context "Return to the selected capability and overview."
  frame workbench {
    header {
      use header-controls flow-header
    }
    top {
      bar return-context {
        start {
          link return "Resume app / Tailor a resume to a role" goto=capability
        }
      }
    }
    main {
      diagram workflow source="src/data/flows/resume-alignment.diagram" view=base
    }
    aside {
      use inspector-content flow-inspector
    }
  }
}
screen picker "Choose a diagram" basis=proposed {
  frame page content=790 {
    body {
      text "User Flow Workbench" role=heading
      text "Choose a diagram" role=title
      text "Files in this workspace and its subfolders"
      list documents {
        item overview-entry "Resume app" detail="Overview" goto=overview
        item flow-entry "Tailor a resume to a job posting" detail="Flow" goto=current
      }
      text "One extension. Type comes from file metadata." role=caption
    }
  }
}

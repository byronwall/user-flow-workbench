flow 3

# Semantic graph
graph checkout "Online checkout"
description "Show the path from purchase intent to a confirmed order."

node shopper actor "Shopper" body="Wants to buy the items in the cart."
node complete-purchase need "Complete the purchase with confidence" body="Understand the total, delivery promise, and payment result." tags=["trust"]
node payment-details input "Payment details" body="The payment method and authorization details supplied by the shopper." tags=["required","supplied-by:shopper"]
node review process "Review order" body="Confirm items, quantities, price, delivery, and contact details."
node payment process "Submit payment" body="Authorize the selected payment method." tags=["checkout","money"]
node payment-result handoff "Payment result" body="Send the authorization result into order creation."
node receipt deliverable "Order receipt" body="Record the purchased items, total, payment state, and delivery promise."
node recovery ux "Explain payment recovery" body="Show what failed and preserve the order before another attempt."

# Directed relationships
edge shopper-provides-payment shopper -> payment-details label="provides"
edge review-to-payment review -> payment label="approve total"
edge details-to-payment payment-details -> payment label="consumed by"
edge payment-to-result payment -> payment-result emphasis=true
edge result-to-receipt payment-result -> receipt label="approved"
edge review-addresses-purchase review -> complete-purchase relation=addresses
edge recovery-at-payment recovery -> payment relation=appears-at
edge recovery-supports-purchase recovery -> complete-purchase relation=supports

# A variant stores ordered differences from the shared graph.
variant express "Express checkout" {
  description "Use saved details for a returning shopper."

  remove edge review-to-payment
  set node payment-details title="Saved payment details" body="A stored payment method selected by the returning shopper." tags=["required","supplied-by:account"]
  set edge shopper-provides-payment label="selects"
  set node review title="Confirm saved order details"
  set node payment title="Confirm saved payment"
  add edge express-payment review -> payment label="use saved details"
}

# Optional semantic layout hints
# Add layout=<column>,<row> to any node line when automatic placement needs guidance.

# Optional manual positions
# Delete these lines to request a fresh automatic layout.
position shopper 88,236
position payment-details 354,318
position review 620,154
position payment 620,318
position payment-result 886,236
position receipt 1152,154
